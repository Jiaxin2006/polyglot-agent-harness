{
  "description": "Polyglot harness — optional SessionStart banner (non-blocking)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
